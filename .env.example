PORT=5000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

API_CAMBIO_URL_KEY=https://co.dolarapi.com

# Supabase Storage (S3-compatible) — documentos de solicitud
SUPABASE_S3_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_REGION=ca-central-1
S3_BUCKET_CEDULA=cedula
S3_BUCKET_INGRESOS=Ingresos
SUPABASE_STORAGE_PUBLIC_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public
