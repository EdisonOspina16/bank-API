
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="your-database-url"
# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="your-direct-url"

# Api key for the currency exchange service
API_CAMBIO_URL_KEY=https://www.datos.gov.co/resource/32sa-8pi3.json

# Historical TRM data (30 days)
TRM_HISTORICAL_API_KEY=https://www.datos.gov.co/resource/32sa-8pi3.json?$order=vigenciadesde DESC&$limit=30

# jwt secret for signing and verifying tokens
JWT_SECRET=your-jwt-secret

# Supabase Storage configuration for AWS S3 compatibility 
SUPABASE_S3_ENDPOINT="your-s3-endpoint"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
S3_REGION="your-region"
S3_BUCKET_NAME="your-bucket-name"
SUPABASE_STORAGE_PUBLIC_URL="https://your-project-id.supabase.co/storage/v1/object/public"
